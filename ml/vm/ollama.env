# systemd override for ollama.service on cover-a100 (ml/vm/setup.sh copies it to
# /etc/systemd/system/ollama.service.d/override.conf).
# 127.0.0.1 only: reach it through `gcloud compute ssh cover-a100 -- -L 11434:127.0.0.1:11434`.
# 96 requests at once, as serve-jev-a100 ran Serve's teacher. Each request gets OLLAMA_CONTEXT_LENGTH tokens, and the
# runner holds all 96, so the KV cache is q8_0 (with flash attention, which it needs) to fit beside the 17 GB model.
[Service]
Environment="OLLAMA_HOST=127.0.0.1:11434"
Environment="OLLAMA_NUM_PARALLEL=96"
Environment="OLLAMA_CONTEXT_LENGTH=4096"
Environment="OLLAMA_MAX_QUEUE=2048"
Environment="OLLAMA_KEEP_ALIVE=24h"
Environment="OLLAMA_FLASH_ATTENTION=1"
Environment="OLLAMA_KV_CACHE_TYPE=q8_0"
Environment="OLLAMA_MAX_LOADED_MODELS=1"
