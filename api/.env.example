# Done & Paid server (api/.env). Never commit real values.
PORT=8810
# PUBLIC_URL=http://localhost:8810        # an https URL here also registers PayPal webhooks
# PayPal sandbox app (without these the server runs on the PayPal stand-in, pay/mock.js)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_TEST_CARD=1                      # holds with PayPal's published sandbox test card (judges have no buyer login)
# PAYPAL_MODE=mock                      # force the stand-in even with keys
# PAYPAL_WEBHOOK_ID=                    # to verify webhooks (set automatically when registered on https)
# HOLD_MODE=authorize                   # or capture: PLAN §12 fallback (charge now, keep at the platform)
# DONE_MULTIPARTY=1                     # try the pro as payee + platform_fees (sandbox refuses without partner onboarding)
# DONE_PRO_PAYPAL_EMAIL=                # a sandbox personal account every demo pro is paid to (else unclaimed stand-ins)
# DONE_HELPER_PAYPAL_EMAIL=             # same, for demo helpers
# DONE_STATE_DIR=../data/state          # where the JSON stores live ("memory" keeps nothing)
# DONE_UPLOADS=../data/uploads          # evidence files
# DONE_AI=live                          # rules = never call the models (tests default to rules)
# DEMO_SIGNIN=1                         # one-click demo sign-in, demo controls, staff
# ADMIN_TOKEN=                          # staff sign-in when DEMO_SIGNIN=0
# TICK_MS=60000  RECEIPT_BATCH_MS=120000  RECON_MS=0  AGENT_RPM=120
# our models (ml/serve.mjs on a GPU box): one HTTPS endpoint for chat, audit, the VLM and Done-OCR /read
# DONE_MODEL_URL=https://your-model-host:8443
# DONE_AUDIT_URL=https://your-model-host:8443
# DONE_VLM_URL=https://your-model-host:8443
# DONE_OCR_URL=https://your-model-host:8443
# DONE_MODEL_TOKEN=                     # the Bearer token ml/serve.mjs was started with (DONE_SERVE_TOKEN)
# NODE_EXTRA_CA_CERTS=certs/model-host.pem  # if the model host uses a self-signed certificate
